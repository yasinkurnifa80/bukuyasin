---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import Hero from "@/components/widgets/Hero.astro";
import Features from "@/components/widgets/Features.astro";
import devImg from "@/assets/images/dev_balanced.png";
import openSourceImg from "@/assets/images/open-source.png";
import Content2 from "@/components/widgets/Content2.astro";

// Memanggil data artikel blog untuk kebutuhan SEO dan update otomatis
import { getCollection } from "astro:content";

// Mengambil semua artikel dari folder src/content/blog/
const allPosts = await getCollection("blog");

// Mengurutkan artikel berdasarkan tanggal rilis terbaru, lalu potong ambil 3 saja untuk Landing Page
const latestPosts = allPosts
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
  )
  .slice(0, 3);

const metadata = {
  title: "Cetak Buku Yasin & Tahlil Murah — ABA Print",
  description:
    "Jasa cetak buku yasin dan tahlil terpercaya, murah, dan berkualitas. Melayani berbagai macam model cover elegan untuk acara mengenang wafatnya keluarga tercinta.",
  ignoreTitleTemplate: true,
};
---

<BaseLayout {metadata}>
  <Hero
    title={`Cetak Buku Yasin & Tahlil <br class="hidden md:block" /> <span class="bg-linear-to-r from-green-600 via-emerald-500 to-yellow-500 bg-clip-text text-transparent"> Berkualitas & Elegan</span>`}
    tagline="Percetakan ABA Print"
    description="Kami menyediakan layanan cetak buku yasin untuk mengenang 40 hari, 100 hari, atau 1000 hari wafatnya keluarga tercinta. Proses cepat, hasil rapi, pilihan cover premium, dan harga sangat terjangkau."
    actions={[
      {
        text: "Hubungi WhatsApp",
        href: siteConfig.socialLinks.whatsapp, // Otomatis terhubung ke data asli di site.ts Anda
        variant: "primary",
        icon: "lucide:message-circle",
      },
      {
        text: "Daftar Harga & Model",
        href: "/harga", // Diselaraskan dengan konfigurasi rute menu navigasi /harga Anda
        variant: "secondary",
        icon: "lucide:book-open",
        ariaLabel: "Lihat koleksi produk buku yasin",
      },
    ]}
  />

  <Features
    tagline="Layanan Kami"
    title="Mengapa Memilih Percetakan ABA Print?"
    subtitle="Kami memberikan jaminan kualitas terbaik untuk setiap buku yasin yang kami produksi."
    features={[
      {
        title: "Harga Super Murah",
        description:
          "Harga bersahabat langsung dari tangan pertama percetakan, sangat cocok untuk anggaran Anda.",
        icon: "lucide:badge-percent",
        iconClass: "bg-green-500/10 text-green-600",
      },
      {
        title: "Hasil Cetak Tajam & Rapi",
        description:
          "Menggunakan mesin cetak modern sehingga tulisan Arab dan terjemahan sangat jelas dibaca.",
        icon: "lucide:check-circle",
        iconClass: "bg-emerald-500/10 text-emerald-600",
      },
      {
        title: "Banyak Pilihan Cover",
        description:
          "Tersedia model Softcover, Hardcover, beludru, hingga motif emas (poly) yang mewah.",
        icon: "lucide:palette",
        iconClass: "bg-yellow-500/10 text-yellow-600",
      },
    ]}
  />

  <Content2
    items={[
      {
        title: "Pilihan Halaman Lengkap",
        description:
          "Tersedia pilihan isi buku yasin mulai dari 128, 144, 160, hingga 208 halaman sesuai kebutuhan.",
        icon: "lucide:book-marked",
        iconClass: "bg-green-500/10 text-green-600",
      },
      {
        title: "Bisa Tambah Foto & Doa",
        description:
          "Gratis sisipan lembar redaksi untuk foto almarhum/almarhumah, susunan nama keluarga, dan doa.",
        icon: "lucide:image",
        iconClass: "bg-emerald-500/10 text-emerald-600",
      },
      {
        title: "Bonus Sajadah / Tasbih",
        description:
          "Dapatkan paket bonus menarik untuk pemesanan dalam jumlah tertentu (syarat & ketentuan berlaku).",
        icon: "lucide:gift",
        iconClass: "bg-yellow-500/10 text-yellow-600",
      },
    ]}
    image={devImg}
    imageAlt="Detail Cetak Buku Yasin"
  >
    <Fragment>
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
        Spesifikasi & Custom Buku Yasin
      </h3>
      Setiap pemesanan bisa disesuaikan sepenuhnya dengan keinginan Anda agar memberikan
      kesan terbaik dan khidmat bagi keluarga dan jamaah.
    </Fragment>
  </Content2>

  <Content2
    items={[
      {
        title: "1. Konsultasi & Pilih Model",
        description:
          "Hubungi kami via WhatsApp, pilih model cover dan jumlah halaman yang diinginkan.",
        icon: "lucide:messages-square",
        iconClass: "bg-emerald-500/10 text-emerald-600",
      },
      {
        title: "2. Pengiriman Data & Desain",
        description:
          "Kirimkan foto almarhum, data tanggal lahir/wafat, serta daftar nama keluarga untuk kami desainkan.",
        icon: "lucide:file-text",
        iconClass: "bg-green-500/10 text-green-600",
      },
      {
        title: "3. Proses Cetak & Kirim",
        description:
          "Setelah desain lembar sisipan Anda setujui (acc), buku langsung masuk tahap cetak dan siap dikirim.",
        icon: "lucide:truck",
        iconClass: "bg-yellow-500/10 text-yellow-600",
      },
    ]}
    image={openSourceImg}
    imageAlt="Proses Pemesanan di ABA Print"
    isReversed={true}
  >
    <Fragment>
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
        Cara Pemesanan Mudah & Cepat
      </h3>
      Anda tidak perlu repot keluar rumah atau menguras waktu. Cukup lakukan pemesanan
      secara online, kami akan proses dengan amanah hingga pesanan sampai di depan
      pintu rumah Anda.
    </Fragment>
  </Content2>

  {
    latestPosts.length > 0 && (
      <section class="py-16 bg-gray-50/50 dark:bg-neutral-900/50 border-t border-gray-100 dark:border-neutral-800">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <div class="text-center max-w-3xl mx-auto mb-12">
            <p class="text-sm text-gray-700 dark:text-neutral-300 font-semibold tracking-wide uppercase">
              Artikel & Panduan
            </p>
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl mt-1">
              Seputar Buku Yasin & Tahlil
            </h2>
            <p class="text-base text-gray-600 dark:text-neutral-400 mt-3">
              Simak tips bermanfaat, panduan memilih bahan cover, hingga susunan
              doa tahlil lengkap di blog kami.
            </p>
          </div>

          <div class="grid gap-8 grid-cols-1 md:grid-cols-3">
            {latestPosts.map((post) => (
              <article class="flex flex-col overflow-hidden rounded-xl border border-gray-100 dark:border-neutral-800 bg-white dark:bg-neutral-950 shadow-xs transition-all hover:shadow-md">
                <div class="flex flex-1 flex-col p-6">
                  <div class="flex-1">
                    <p class="text-xs font-medium text-gray-600 dark:text-neutral-400">
                      {new Date(post.data.pubDate).toLocaleDateString("id-ID", {
                        day: "numeric",
                        month: "long",
                        year: "numeric",
                      })}
                    </p>
                    <a href={`/blog/${post.id}`} class="mt-2 block">
                      <h3 class="text-xl font-bold text-gray-900 dark:text-white hover:text-gray-700 dark:hover:text-neutral-300 transition-colors line-clamp-2">
                        {post.data.title}
                      </h3>
                      <p class="mt-3 text-sm text-gray-500 dark:text-neutral-400 line-clamp-3">
                        {post.data.description}
                      </p>
                    </a>
                  </div>
                  <div class="mt-6 flex items-center">
                    <a
                      href={`/blog/${post.id}`}
                      class="text-sm font-semibold text-gray-700 dark:text-neutral-300 hover:underline inline-flex items-center gap-1"
                    >
                      Baca Selengkapnya <span>&rarr;</span>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style is:global>
  /* Menembak tombol pertama di dalam komponen Hero */
  section div a[href^="https://wa.me"] {
    background-color: #16a34a !important;
    color: #ffffff !important;
    border-color: #16a34a !important;
  }
  section div a[href^="https://wa.me"]:hover {
    background-color: #15803d !important;
    border-color: #15803d !important;
  }
</style>

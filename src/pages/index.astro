---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { siteConfig } from "@/config/site";
import Hero from "@/components/widgets/Hero.astro";
import Features from "@/components/widgets/Features.astro";
import Content2 from "@/components/widgets/Content2.astro";
import { getCollection } from "astro:content";

// Import gambar
import devImg from "@/assets/images/spesifikasi-buku-yasin.webp";
import openSourceImg from "@/assets/images/cara-pemesanan-buku-yasin.webp";
import heroImg from "@/assets/images/percetakan-buku-yasin-premium3.png";

const allPosts = await getCollection("blog");
const latestPosts = allPosts
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
  )
  .slice(0, 3);

const postCardClasses = [
  "bg-white border-gray-200 dark:bg-slate-900 dark:border-slate-700",
  "bg-gray-50 border-gray-200 dark:bg-slate-800 dark:border-slate-700",
  "bg-white border-gray-200 dark:bg-slate-900 dark:border-slate-700",
];

const metadata = {
  title: "Cetak Buku Yasin Terpercaya — ABA Print",
  description:
    "Jasa cetak buku yasin dan tahlil terdekat di Makassar dan Sulawesi, murah, dan berkualitas.",
  ignoreTitleTemplate: true,
};
---

<BaseLayout {metadata}>
  <!-- Hero Section -->
  <Hero
    tagline="Percetakan ABA Print"
    bg="section-blue border-b border-border"
    actions={[
      {
        text: "Hubungi WhatsApp",
        href: siteConfig.socialLinks.whatsapp,
        variant: "whatsapp",
        icon: "tabler:brand-whatsapp",
      },
      {
        text: "Daftar Harga & Model",
        href: "/harga",
        variant: "secondary",
        icon: "lucide:book-open",
        ariaLabel: "Lihat koleksi produk buku yasin",
      },
    ]}
  >
    <Fragment slot="title">
      <h1
        class="text-foreground font-extrabold text-4xl md:text-6xl leading-[1.2] block mb-8 mt-5"
      >
        Percetakan Yasin Terpercaya
      </h1>
      <h2 class="block leading-[1.6] mt-4">
        <span class="text-primary font-bold text-2xl md:text-4xl block mb-1"
          >Melalui Bus, Kirim se-Sulsel</span
        >
        <span
          class="text-foreground/85 font-medium text-xl md:text-3xl block mt-1"
        >
          Alternatif Lain <span class="font-black" style="color: #ff5722;"
            >Bisa Transaksi di Shopee</span
          >
        </span>
        <span
          class="text-foreground/85 font-medium text-xl md:text-3xl block mt-1"
        >
          Belanja <span class="font-black" style="color: #F7259E;"
            >Jadi Aman !</span
          >
        </span>
      </h2>
    </Fragment>

    <Fragment slot="description">
      <span
        class="block mt-12 leading-[1.6] text-lg text-gray-950 dark:text-white font-medium"
      >
        <strong>Mau Cetak buku Yasin ? </strong><br />Tanpa repot, tanpa harus
        keluar rumah?<br /><br />
        <strong>Ya, fokuslah pada doa dan keluarga,</strong><br /> Biarkan kami yang
        mencetak kenangan terbaik Anda Untuk Almarhum.
      </span>
    </Fragment>
  </Hero>

  <!-- Hero Image Section -->
  <div class="mt-8 flex justify-center py-6">
    <Image
      src={heroImg}
      alt="Contoh hasil cetakan buku yasin premium di Makassar"
      class="rounded-lg max-w-md w-full h-auto shadow-lg"
      width={400}
      height={300}
      format="webp"
      quality={80}
    />
  </div>

  <!-- Features Section -->
  <Features
    bg="section-cream"
    tagline="Layanan Kami"
    title="Mengapa Memilih Percetakan ABA Print?"
    subtitle="Kami memberikan jaminan kualitas terbaik untuk setiap buku yasin yang kami produksi."
    features={[
      {
        title: "Harga Terjangkau",
        description: "Harga bersahabat langsung dari tangan pertama.",
        icon: "lucide:badge-percent",
        iconClass: "bg-blue-500/10 text-blue-600",
      },
      {
        title: "Hasil Cetak Tajam & Rapi",
        description: "Menggunakan mesin cetak modern.",
        icon: "lucide:check-circle",
        iconClass: "bg-amber-500/10 text-amber-600",
      },
      {
        title: "Banyak Pilihan Cover",
        description: "Softcover, Hardcover, beludru, dll.",
        icon: "lucide:palette",
        iconClass: "bg-blue-500/10 text-blue-600",
      },
    ]}
  />

  <!-- Content Sections -->
  <Content2
    bg="section-yellow"
    image={devImg}
    imageAlt="Detail Cetak Buku Yasin"
  >
    <h3
      class="text-2xl font-bold tracking-tight sm:text-3xl mb-4 text-gray-950 dark:text-white"
    >
      Spesifikasi & Custom Buku Yasin
    </h3>
    <p
      class="font-sans font-medium text-gray-900 dark:text-gray-100 leading-[1.6]"
    >
      Setiap pemesanan bisa disesuaikan sepenuhnya dengan keinginan Anda agar
      memberikan kesan terbaik.
    </p>
  </Content2>

  <Content2
    bg="section-sky"
    image={openSourceImg}
    imageAlt="Proses Pemesanan"
    isReversed={true}
  >
    <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-4">
      Cara Pemesanan Mudah & Cepat
    </h3>
    <p class="leading-[1.6]">
      Cukup lakukan pemesanan secara online, kami akan proses dengan amanah
      hingga sampai di depan pintu rumah Anda.
    </p>
  </Content2>

  <!-- Blog Section -->
  {
    latestPosts.length > 0 && (
      <section class="py-16 bg-gray-100 dark:bg-slate-950 border-t border-gray-200 dark:border-gray-800">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <h2 class="text-3xl font-bold text-center mb-12">
            Seputar Buku Yasin & Tahlil
          </h2>
          <div class="grid gap-8 grid-cols-1 md:grid-cols-3">
            {latestPosts.map((post, index) => (
              <article
                class:list={[
                  "flex flex-col rounded-xl border shadow-xs overflow-hidden",
                  postCardClasses[index % 3],
                ]}
              >
                <a href={`/blog/${post.id}`}>
                  {post.data.image && (
                    <Image
                      src={post.data.image}
                      alt={post.data.title}
                      width={400}
                      height={225}
                      class="w-full h-48 object-cover"
                    />
                  )}
                  <div class="p-6">
                    <h3 class="text-xl font-bold">{post.data.title}</h3>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

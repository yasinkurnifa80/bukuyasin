---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Form from "@/components/ui/Form.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import locationImage from "@/assets/images/laman-lain.webp";

const metadata = {
  title: "Hubungi Kami & Lokasi Workshop - ABA Print Makassar",
  description:
    "Hubungi kami via WhatsApp atau kunjungi workshop Percetakan Buku Yasin 24 Jam & Laundry ABA Print di Paccerakkang, Makassar.",
};

const contactText = [
  "Punya pertanyaan mengenai cetak buku Yasin atau layanan laundry? Silakan hubungi kami via WhatsApp, isi formulir di bawah, atau langsung kunjungi workshop kami.",
];
---

<BaseLayout {metadata}>
  <div class="pt-10 pb-4 text-center max-w-3xl mx-auto px-4">
    <span
      class="text-primary font-bold tracking-widest uppercase text-xs block mb-2"
    >
      Hubungi & Kunjungi Kami
    </span>
    <h1
      class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white mb-3"
    >
      Kami Siap Membantu Kebutuhan Anda
    </h1>
    <p
      class="text-gray-600 dark:text-slate-300 text-sm md:text-base leading-relaxed"
    >
      {contactText}
    </p>
  </div>

  <div
    class="surface-blue reveal mx-auto max-w-xl border rounded-3xl p-6 shadow-xl mb-4 dark:bg-slate-900 dark:border-slate-800"
  >
    <h3 class="text-lg font-semibold mb-3 text-center dark:text-white">
      Formulir Konsultasi
    </h3>
    <Form />
  </div>

  <section class="section-cream pt-0 pb-12 dark:bg-slate-950">
    <div class="container mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        {/* Kolom Informasi */}
        <div class="space-y-6">
          <div>
            <span
              class="text-primary font-bold tracking-widest uppercase text-sm"
            >
              Workshop Kami
            </span>
            <h2
              class="text-3xl font-extrabold text-gray-900 dark:text-white mt-2"
            >
              Percetakan Buku Yasin 24 Jam & Laundry
            </h2>
          </div>

          <div class="flex gap-4">
            <Icon
              name="lucide:map-pin"
              class="w-6 h-6 text-primary flex-shrink-0"
            />
            <div>
              <h3 class="font-bold text-base dark:text-white">Alamat</h3>
              <p class="text-gray-600 dark:text-slate-300 text-sm">
                Jl. Paccerakkang, Paccerakkang, Kec. Biringkanaya, Kota
                Makassar, Sulawesi Selatan 90562
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <Icon
              name="lucide:clock"
              class="w-6 h-6 text-primary flex-shrink-0"
            />
            <div>
              <h3 class="font-bold text-base dark:text-white">
                Jam Operasional
              </h3>
              <p class="text-gray-600 dark:text-slate-300 text-sm">
                Layanan Cetak: 24 Jam Nonstop
              </p>
              <p class="text-gray-600 dark:text-slate-300 text-sm">
                Layanan Laundry: 08.00 - 20.00 WITA
              </p>
            </div>
          </div>

          <a
            href="https://wa.me/62895401308267"
            class="inline-flex items-center gap-3 px-6 py-3 bg-[#25D366] hover:bg-[#20BA5A] text-white rounded-xl font-bold hover:shadow-lg hover:shadow-green-500/20 hover:scale-105 transform transition duration-300 shadow-lg text-sm shadow-green-500/10"
          >
            <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
            Hubungi via WhatsApp
          </a>

          <div class="pt-4">
            <Image
              src={locationImage}
              alt="Lokasi workshop ABA Print"
              class="rounded-2xl shadow-md w-full h-56 object-cover"
            />
          </div>
        </div>

        {/* Kolom Peta */}
        <div
          class="w-full h-[500px] rounded-3xl overflow-hidden shadow-2xl border border-gray-100 dark:border-slate-800"
        >
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d56130.296508469575!2d119.42961514158108!3d-5.131660130369637!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dbefb003eb483c1%3A0x60443c069123aa90!2sPercetakan%20Buku%20Yasin%2024%20Jam%20%26%20Laundry%20Terdekat!5e1!3m2!1sid!2sid!4v1779610997002!5m2!1sid!2sid"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

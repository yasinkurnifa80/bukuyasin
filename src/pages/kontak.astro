---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Form from "@/components/ui/Form.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import locationImage from "@/assets/images/laman-lain.webp";

const metadata = {
  title: "Hubungi Kami & Lokasi Workshop - ABA Print Makassar",
  description:
    "Hubungi kami via WhatsApp atau kunjungi workshop Percetakan Buku Yasin 24 Jam & Laundry ABA Print di Paccerakkang, Makassar.",
};

// Teks pembuka yang relevan untuk halaman kontak
const contactText = [
  "Punya pertanyaan mengenai cetak buku Yasin atau layanan laundry? Silakan hubungi kami via WhatsApp, isi formulir di bawah, atau langsung kunjungi workshop kami.",
];
---

<BaseLayout {metadata}>
  <div class="pt-10 pb-4 text-center max-w-3xl mx-auto px-4">
    <span
      class="text-emerald-600 font-bold tracking-widest uppercase text-xs block mb-2"
    >
      Hubungi & Kunjungi Kami
    </span>
    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-3">
      Kami Siap Membantu Kebutuhan Anda
    </h1>
    <p class="text-gray-600 text-sm md:text-base leading-relaxed">
      {contactText}
    </p>
  </div>

  <div
    class="reveal mx-auto max-w-xl bg-card border border-border rounded-3xl p-6 shadow-xl mb-4"
  >
    <h3 class="text-lg font-semibold mb-3 text-center">Formulir Konsultasi</h3>
    <Form />
  </div>

  <section class="pt-0 pb-12 bg-white">
    <div class="container mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        {/* Kolom Informasi */}
        <div class="space-y-6">
          <div>
            <span
              class="text-emerald-600 font-bold tracking-widest uppercase text-sm"
            >
              Workshop Kami
            </span>
            <h2 class="text-3xl font-extrabold text-gray-900 mt-2">
              Percetakan Buku Yasin 24 Jam & Laundry
            </h2>
          </div>

          <div class="flex gap-4">
            <Icon
              name="lucide:map-pin"
              class="w-6 h-6 text-emerald-600 flex-shrink-0"
            />
            <div>
              <h3 class="font-bold text-base">Alamat</h3>
              <p class="text-gray-600 text-sm">
                Jl. Paccerakkang, Paccerakkang, Kec. Biringkanaya, Kota
                Makassar, Sulawesi Selatan 90562
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <Icon
              name="lucide:clock"
              class="w-6 h-6 text-emerald-600 flex-shrink-0"
            />
            <div>
              <h3 class="font-bold text-base">Jam Operasional</h3>
              <p class="text-gray-600 text-sm">Layanan Cetak: 24 Jam Nonstop</p>
              <p class="text-gray-600 text-sm">
                Layanan Laundry: 08.00 - 20.00 WITA
              </p>
            </div>
          </div>

          <a
            href="https://wa.me/6289519865963"
            class="inline-flex items-center gap-3 px-6 py-3 bg-emerald-600 text-white rounded-xl font-bold hover:bg-emerald-700 transition shadow-lg text-sm"
          >
            <Icon name="lucide:message-circle" class="w-4 h-4" />
            Hubungi via WhatsApp
          </a>

          <div class="pt-4">
            <Image
              src={locationImage}
              alt="Lokasi workshop ABA Print"
              class="rounded-2xl shadow-md w-full h-56 object-cover"
            />
          </div>
        </div>

        {/* Kolom Peta (Embed Google Maps) */}
        <div
          class="w-full h-[500px] rounded-3xl overflow-hidden shadow-2xl border border-gray-100"
        >
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3973.743123689437!2d119.4359!3d-5.1557!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNcKwMDknMjAuNSJTIDExOcKwMjYnMDkuMiJF!5e0!3m2!1sid!2sid!4v1716110000000!5m2!1sid!2sid"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

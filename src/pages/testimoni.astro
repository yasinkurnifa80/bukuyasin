---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { getImage } from "astro:assets";
import Card from "@/components/ui/Card.astro";

import testimoniImage from "@/assets/images/hasil-cetak-yasin.webp";

const metadata = {
  title: "Testimoni Pelanggan — Kepercayaan Anda adalah Amanah bagi ABA Print",
  description:
    "Simak apa kata mereka yang telah mempercayakan cetak buku Yasin kepada ABA Print. Kualitas premium dan pelayanan amanah untuk Anda.",
};

const enrichedTestimonials = [
  {
    name: "Bpk. Ahmad Fauzi",
    rating: 5,
    avatarColor: "bg-blue-100 text-blue-800",
    reviewTitle: "Hasil Sangat Rapi & Cepat",
    comment:
      "Alhamdulillah, buku Yasin untuk 40 harian almarhumah ibu sudah sampai tepat waktu. Kualitas cetakannya tajam sekali, jilidnya kuat. Terima kasih ABA Print atas layanannya.",
  },
  {
    name: "Ibu Sari Ratna",
    rating: 5,
    avatarColor: "bg-amber-100 text-amber-800",
    reviewTitle: "Sangat Membantu Desain",
    comment:
      "Awalnya bingung buat layout foto dan doa sisipan, tapi dibantu sama tim desainer ABA Print sampai hasilnya pas. Sangat sabar dan komunikatif.",
  },
  {
    name: "Keluarga Besar Alm. Bpk. Rusli",
    rating: 5,
    avatarColor: "bg-blue-100 text-blue-800",
    reviewTitle: "Harga Sesuai Kualitas",
    comment:
      "Puas banget, pesan 100 pcs untuk tahlilan keluarga besar. Kertasnya tebal dan finishingnya eksklusif. Tamu yang datang banyak yang memuji buku Yasinnya.",
  },
  {
    name: "Pak RT Setiawan",
    rating: 5,
    avatarColor: "bg-amber-100 text-amber-800",
    reviewTitle: "Pelayanan Sangat Amanah",
    comment:
      "Luar biasa, dari diskusi di WhatsApp sampai pengiriman sangat dimudahkan. Tidak ada biaya aneh-aneh dan hasilnya benar-benar sesuai contoh.",
  },
  {
    name: "Mas Doni - Bekasi",
    rating: 5,
    avatarColor: "bg-blue-100 text-blue-800",
    reviewTitle: "Detail Sangat Terjaga",
    comment:
      "Detail huruf arabnya jelas, tidak blur. Sangat enak dibaca jamaah. Ini cetakan buku Yasin terbaik yang pernah saya pesan selama ini.",
  },
  {
    name: "Ibu Nur Hidayah",
    rating: 5,
    avatarColor: "bg-amber-100 text-amber-800",
    reviewTitle: "Sangat Direkomendasikan",
    comment:
      "Kalau cari tempat cetak Yasin yang nggak pakai lama dan kualitasnya premium, langsung ke ABA Print saja. Sangat rekomended!",
  },
];

const optimizedImage = await getImage({
  src: testimoniImage,
  format: "webp",
});

const cardVariants = ["sage", "blue", "amber", "clay"] as const;
---

<BaseLayout {metadata}>
  <link slot="head" rel="preload" href={optimizedImage.src} as="image" />

  <section class="section-sky py-20">
    <div class="container mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-20">
        <span class="text-primary font-bold tracking-widest uppercase text-sm">
          Kata Mereka
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white mt-3 mb-6">
          Apa Kata Pelanggan Tentang ABA Print?
        </h1>
        <p class="text-xl text-gray-600 dark:text-slate-300">
          Kami bangga bisa memberikan dedikasi terbaik bagi setiap keluarga yang
          mempercayakan kebutuhan buku Yasin kepada kami. Kepercayaan Anda
          adalah Amanah yang Kami Jaga.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
        {
          enrichedTestimonials.map((review, index) => (
            <Card
              class="flex flex-col gap-6"
              variant={cardVariants[index % cardVariants.length]}
            >
              <div class="flex items-center gap-4">
                <div
                  class={`w-16 h-16 rounded-full flex items-center justify-center font-extrabold text-2xl shadow-inner flex-shrink-0 ${review.avatarColor}`}
                >
                  {review.name.substring(0, 1)}
                </div>

                <div class="flex-grow flex flex-col gap-1">
                  <h3 class="text-lg font-bold text-gray-900 dark:text-white leading-tight">
                    {review.name}
                  </h3>

                  <div class="flex items-center gap-0.5 text-amber-500">
                    {[...Array(review.rating)].map(() => (
                      <Icon name="lucide:star" class="w-5 h-5 fill-amber-400" />
                    ))}
                  </div>
                </div>
              </div>

              <div class="flex-grow border-l-4 border-primary pl-4">
                <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-1.5">
                  {review.reviewTitle}
                </h4>
                <p class="text-gray-700 dark:text-slate-300 leading-relaxed text-base italic">
                  "{review.comment}"
                </p>
              </div>

              <div class="pt-4 border-t border-border mt-auto flex items-center gap-2 text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-widest">
                <Icon
                  name="lucide:shield-check"
                  class="w-4 h-4 text-primary"
                />
                Terverifikasi di : maps : ABA Print Makassar
              </div>
            </Card>
          ))
        }
      </div>

      <div class="mt-20 text-center">
        <p class="text-xl text-gray-600 dark:text-slate-300 mb-8 max-w-2xl mx-auto">
          Mari wujudkan buku Yasin terbaik untuk keluarga tercinta bersama kami.
          Kualitas premium dan pelayanan amanah untuk Anda.
        </p>
        <a
          href="https://wa.me/62895401308267"
          class="inline-flex items-center gap-3 px-10 py-5 bg-[#25D366] hover:bg-[#20BA5A] text-white rounded-full font-bold text-lg hover:shadow-xl hover:shadow-green-500/20 hover:scale-105 transform transition-all duration-300 shadow-lg shadow-green-500/10"
        >
          <Icon name="tabler:brand-whatsapp" class="w-6 h-6" />
          Konsultasi Pesanan Anda Sekarang
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
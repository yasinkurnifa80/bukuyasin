---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/widgets/Hero.astro";

const metadata = {
  title: "Halaman Tidak Ditemukan (404) — ABA Print",
  description: "Maaf, halaman yang Anda cari tidak ditemukan.",
  ignoreTitleTemplate: true,
};
---

<BaseLayout {metadata}>
  <Hero
    title={`<h1 class="text-primary text-[8rem] md:text-[12rem] font-extrabold tracking-tighter mb-4">404</h1>`}
    bg="section-blue"
    description="Mohon maaf, halaman yang Anda cari tidak ditemukan. Mungkin halaman telah dipindahkan atau tautan tidak lagi aktif."
    actions={[
      {
        variant: "primary",
        text: "Kembali ke Beranda",
        href: "/",
        icon: "lucide:home",
      },
      {
        variant: "secondary",
        text: "Hubungi Kami",
        href: "/contact",
        icon: "lucide:phone",
      },
    ]}
  />
</BaseLayout>

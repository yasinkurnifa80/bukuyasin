---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

// Menggunakan gambar tentang-kami yang sudah ada di aset proyek Anda
import aboutImage from "@/assets/images/tentang-kami.webp";

const metadata = {
  title:
    "Tentang Kami — Perjalanan Spesialis Cetak Buku Yasin ABA Print Makassar",
  description:
    "Kisah di balik ABA Print Makassar. Berawal dari masa sulit berbekal mesin sederhana hingga kini tumbuh menjadi percetakan Buku Yasin profesional yang amanah.",
};
---

<BaseLayout {metadata}>
  <section class="section-cream py-20">
    <div class="container mx-auto px-6">
      {/* --- HERO TITLE --- */}
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-primary font-bold tracking-widest uppercase text-sm">
          Kisah Di Balik ABA Print
        </span>
        <h1
          class="text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white mt-3 mb-6 leading-tight"
        >
          Dari Sudut Sempit Kota Makassar, Menjaga Amanah dengan Sepenuh Hati
        </h1>
        <div class="w-24 h-1 bg-primary mx-auto rounded-full"></div>
      </div>

      {/* --- BAGIAN NARASI UTAMA --- */}
      <div
        class="grid md:grid-cols-2 gap-12 items-center max-w-6xl mx-auto mb-28"
      >
        {/* Kolom Kiri: Gambar */}
        <div
          class="w-full aspect-square max-w-md mx-auto md:max-w-none overflow-hidden rounded-3xl shadow-2xl border border-border order-2 md:order-1"
        >
          <Image
            src={aboutImage}
            alt="Perjalanan dedikasi pembuatan Buku Yasin ABA Print Makassar"
            class="w-full h-full object-cover aspect-square transition-transform duration-500 hover:scale-105"
          />
        </div>

        {/* Kolom Kanan: Narasi Storytelling (Sudah mendukung Dark Mode) */}
        <div
          class="space-y-6 text-gray-700 dark:text-slate-300 text-lg order-1 md:order-2 leading-relaxed"
        >
          <h2
            class="text-2xl md:text-3xl font-bold text-gray-950 dark:text-white mb-4 border-b-2 border-secondary pb-2 inline-block"
          >
            Sebuah Awal yang Tidak Mudah...
          </h2>
          <p>
            Beberapa tahun lalu, kami memulai langkah di sebuah sudut kecil di
            kota Makassar dengan sebuah keterbatasan. Kami pernah berada di <strong
              class="text-gray-950 dark:text-white">masa-masa sulit</strong
            >, merintis usaha hanya berbekal alat seadanya, dan kerap melewati
            malam tanpa tidur demi memastikan selembar demi selembar halaman
            selesai terikat dengan rapi.
          </p>
          <p>
            Di masa-masa sulit itu, kami belajar satu pelajaran berharga yang
            membentuk jati diri kami hari ini:
            <em class="text-gray-950 dark:text-white"
              >kepercayaan orang lain adalah hal paling mahal yang tidak boleh
              dicederai.</em
            >
          </p>
          <p>
            Kami menyadari bahwa keluarga yang datang ke ABA Print adalah
            keluarga yang sedang berduka, yang ingin memberikan
            <strong class="text-gray-950 dark:text-white"
              >penghormatan terakhir dan mengalirkan pahala jariyah</strong
            >
            bagi almarhum/almarhumah melalui untaian ayat suci Yasin.
          </p>
          <p
            class="border-l-4 border-primary pl-4 bg-blue-50/30 dark:bg-blue-950/30 py-3 rounded-r-xl italic text-gray-900 dark:text-slate-100 font-medium"
          >
            "Bagi kami, ini bukan sekadar urusan cetak-mencetak bisnis belaka.
            Ini adalah tugas suci untuk membantu Anda menyampaikan doa terbaik
            yang akan dibaca berulang kali oleh sanak saudara dan jamaah di
            Makassar."
          </p>
          <p>
            Hari ini, kami tetap membawa semangat pelayan yang ramah, teliti,
            dan penuh empati agar buku doa Anda untuk almarhum tercinta dapat
            terwujud. SALAM.
          </p>
        </div>
      </div>

      {/* --- CTA SECTION --- */}
      <div class="mt-20 text-center">
        <div
          class="inline-flex flex-col sm:flex-row items-center gap-4 justify-center"
        >
          <a
            href="https://wa.me/62895401308267"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-10 py-5 bg-[#25D366] hover:bg-[#20BA5A] text-white rounded-full font-bold text-lg hover:shadow-xl hover:shadow-green-500/20 hover:scale-105 transform transition-all duration-300 shadow-lg shadow-green-500/10"
          >
            <Icon name="tabler:brand-whatsapp" class="w-6 h-6" />
            Hubungi Kami (WhatsApp)
          </a>
          <a
            href="/layanan"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-10 py-5 bg-[#fff4e5] text-gray-900 border border-[#efd2a7] rounded-full font-bold text-lg hover:bg-[#f7e6cc] transition-all shadow-md"
          >
            Lihat Pilihan Model Yasin
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import Content2 from "@/components/widgets/Content2.astro";
import Values from "@/components/widgets/Values.astro";

// Tetap menggunakan gambar yang sudah pasti ada di proyek Anda agar tidak error saat di-build
import aboutImage from "@/assets/images/tentang-kami.webp";

const metadata = {
  title: "Tentang Kami — Spesialis Cetak Buku Yasin Premium ABA Print",
  description:
    "Kenali ABA Print lebih dekat. Kami adalah layanan percetakan spesialis buku yasin dan tahlil yang mengutamakan kualitas tak tertandingi dan ketepatan waktu.",
};

const values = [
  {
    title: "Hasil Cetak Tajam & Rapi",
    description:
      "Setiap huruf Arab dan terjemahan dicetak menggunakan mesin modern berkualitas tinggi, memastikan tulisan sangat jelas dan nyaman dibaca oleh jamaah.",
  },
  {
    title: "Jaminan Tepat Waktu",
    description:
      "Kami memahami pentingnya tanggal acara tahlilan (40 hari, 100 hari, atau 1000 hari). Kami berkomitmen menyelesaikan pesanan sesuai jadwal yang disepakati.",
  },
  {
    title: "Bahan Baku Pilihan",
    description:
      "Mulai dari kertas isi (HVS/Art Paper) hingga variasi board hardcover, semua dipilih dari material premium terbaik agar buku kokoh dan tahan bertahun-tahun.",
  },
  {
    title: "Gratis Desain Sisipan",
    description:
      "Tim desainer kami siap membantu menyusun tata letak foto almarhum, data keluarga, dan doa tambahan secara gratis sampai Anda menyatakan setuju (ACC).",
  },
  {
    title: "Proses Transparan",
    description:
      "Tidak ada biaya tersembunyi. Semua spesifikasi bahan, jumlah halaman, dan total biaya diinfokan dengan jelas di awal sebelum naik cetak.",
  },
  {
    title: "Melayani dengan Empati",
    description:
      "Kami memperlakukan setiap pesanan buku yasin dengan rasa hormat yang tinggi, demi membantu Anda memberikan dedikasi terbaik bagi almarhum/almarhumah.",
  },
];

const optimizedImage = await getImage({
  src: aboutImage,
  format: "webp",
});
---

<BaseLayout {metadata}>
  <link slot="head" rel="preload" href={optimizedImage.src} as="image" />

  {/* Bagian Narasi Utama (Copywriting Cerita & Komitmen Toko) */}
  <Content2
    title="Dedikasi Terbaik untuk Mengenang Keluarga Tercinta"
    description={[
      "ABA Print lahir dari sebuah komitmen sederhana: membantu setiap keluarga muslim menghadirkan cinderamata ibadah yang paling layak, rapi, dan mulia saat mengenang wafatnya anggota keluarga tercinta.",
      "Kami memahami bahwa Buku Yasin dan Tahlil yang Anda bagikan bukan sekadar lembaran kertas, melainkan wujud penghormatan, kenangan, serta wasilah doa yang akan terus dibaca oleh kerabat dan jamaah. Oleh karena itu, kami tidak pernah bermain-main dengan kualitas cetakan, kerapian jilid, maupun ketepatan waktu pengerjaan.",
    ]}
    tagline="Tentang Kami"
    image={aboutImage}
    imageAlt="Spesialis Cetak Buku Yasin Premium - ABA Print"
    actions={[
      {
        text: "Tanya Lewat WhatsApp",
        href: "https://wa.me/6289519865963",
        variant: "primary",
        icon: "lucide:message-circle",
      },
      {
        text: "Lihat Pilihan Model",
        href: "/services",
        variant: "secondary",
        icon: "lucide:arrow-right",
      },
    ]}
  />

  {/* Bagian Keunggulan / Nilai Jual yang Membuat Pelanggan Yakin */}
  <Values
    items={values}
    columns={3}
    tagline="Keunggulan Kami"
    title="Mengapa Mempercayakan Cetak Yasin di ABA Print?"
    subtitle="6 Alasan utama mengapa ribuan pelanggan mempercayakan pembuatan buku yasin mengenang almarhum/almarhumah kepada kami."
  />
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/widgets/Hero.astro";
import Features from "@/components/widgets/Features.astro";
import Content from "@/components/widgets/Content.astro";
import Content2 from "@/components/widgets/Content2.astro";
import ServiceList from "@/components/widgets/ServiceList.astro";
import Values from "@/components/widgets/Values.astro";
import aboutImage from "@/assets/images/about-office.webp"; // Pastikan Anda mengganti ini dengan foto hasil cetak Yasin Anda

const heroProps = {
  title: "Jasa Cetak Buku Yasin Eksklusif di Makassar",
  tagline: "Kualitas Premium, Pengerjaan Cepat",
  description:
    "Abadikan doa dan kenangan orang terkasih dengan buku Yasin berkualitas tinggi. Desain elegan, kertas premium, dan pengerjaan yang teliti dari tim profesional kami.",
  actions: [
    {
      text: "Pesan via WhatsApp",
      href: "https://wa.me/628XXXXXXXXXX", // Ganti dengan nomor WhatsApp Anda
      variant: "primary",
      icon: "lucide:message-circle",
      style: "background-color: #25D366; color: white;", // Styling tombol hijau WhatsApp
    },
    {
      text: "Lihat Portofolio",
      href: "#galeri",
      variant: "secondary",
      icon: "lucide:image",
    },
  ],
};

const featuresProps = {
  title: "Mengapa Memilih Kami?",
  subtitle:
    "Kami memberikan hasil terbaik untuk penghormatan terakhir yang berkesan.",
  tagline: "Keunggulan Kami",
  features: [
    {
      title: "Hasil Cetak Tajam",
      description:
        "Menggunakan mesin cetak digital terkini dengan kualitas warna yang awet.",
      icon: "lucide:printer",
    },
    {
      title: "Pilihan Kertas Mewah",
      description:
        "Tersedia pilihan kertas Art Paper, Fancy Paper, hingga kertas HVS putih bersih.",
      icon: "lucide:book-open",
    },
    {
      title: "Pengerjaan Kilat",
      description:
        "Siap melayani pesanan dalam waktu singkat dengan tetap menjaga detail.",
      icon: "lucide:clock",
    },
  ],
};

const contentProps = {
  title: "Proses Pemesanan yang Mudah",
  description: [
    "Kami memahami kesibukan Anda. Anda tidak perlu datang ke kantor, cukup kirimkan data melalui pesan dan kami akan menyusun layout-nya untuk Anda.",
    "Draft desain akan dikirimkan untuk Anda tinjau sebelum masuk ke tahap produksi massal.",
  ],
  tagline: "Kemudahan",
  image: aboutImage,
  imageAlt: "Proses cetak buku Yasin",
  isReversed: false,
};

const serviceListProps = {
  services: [
    {
      title: "Yasin Hardcover",
      description:
        "Tampilan eksklusif dengan jilid kokoh dan laminasi doff/glossy.",
      icon: "lucide:layers",
    },
    {
      title: "Yasin Softcover",
      description: "Pilihan ekonomis namun tetap terlihat cantik dan elegan.",
      icon: "lucide:file-text",
    },
    {
      title: "Desain Custom",
      description:
        "Layout isi buku Yasin bisa disesuaikan dengan permintaan doa khusus.",
      icon: "lucide:palette",
    },
  ],
  title: "Layanan Cetak Kami",
  subtitle: "Pilihan variasi cetak sesuai kebutuhan Anda",
  tagline: "Produk",
};

const metadata = {
  title: "Jasa Cetak Buku Yasin Makassar - Kualitas Terbaik & Terpercaya",
  description:
    "Cetak buku Yasin premium untuk acara tahlilan atau peringatan wafat. Desain eksklusif, pengerjaan cepat di Makassar.",
};
---

<BaseLayout {metadata}>
  <Hero {...heroProps} />
  <Features {...featuresProps} />
  <Content {...contentProps} />
  <ServiceList {...serviceListProps} />
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ServiceList from "@/components/widgets/ServiceList.astro";
import Content from "@/components/widgets/Content.astro";
import Content2 from "@/components/widgets/Content2.astro";
import { Icon } from "astro-icon/components";

// Menggunakan aset gambar yang sudah ada di proyek Anda
import webDevImg from "@/assets/images/dev_balanced.png";
import seoImg from "@/assets/images/open-source.png";

const services = [
  {
    title: "Buku Yasin Softcover",
    description:
      "Pilihan ekonomis dan praktis dengan jilid staples atau lem panas. Desain cover bisa custom penuh menggunakan kertas tebal (Art Carton).",
    icon: "lucide:book",
  },
  {
    title: "Buku Yasin Hardcover",
    description:
      "Tampilan sangat kokoh, mewah, dan awet. Menggunakan papan tebal berlapis kertas premium dengan pilihan poly emas atau perak.",
    icon: "lucide:book-lock",
  },
  {
    title: "Premium Beludru & Majmu Syarif",
    description:
      "Model eksklusif berlapis kain beludru lembut atau kitab Majmu Syarif lengkap untuk kenangan terbaik bagi keluarga tercinta.",
    icon: "lucide:award",
  },
];

const metadata = {
  title: "Daftar Harga & Model Cetak Buku Yasin — ABA Print",
  description:
    "Lihat berbagai pilihan model buku yasin dan tahlil terlengkap di ABA Print. Tersedia model Softcover, Hardcover, hingga kain beludru dengan harga terjangkau.",
};
---

<BaseLayout {metadata}>
  {/* Bagian Header Utama Halaman */}
  <Content
    tagline="Daftar Produk"
    title="Pilihan Model Buku Yasin & Tahlil"
    description={[
      "Kami menyediakan berbagai macam variasi model cover dan ketebalan halaman buku yasin yang bisa disesuaikan sepenuhnya dengan anggaran dan kebutuhan acara mengenang wafatnya keluarga tercinta.",
    ]}
  />

  {/* Daftar Tiga Kategori Utama */}
  <ServiceList services={services} classes={{ container: "pt-0 md:pt-0" }} />

  {/* Detail Spesifikasi 1: Model Softcover */}
  <Content
    tagline="Model Ekonomis"
    title="Buku Yasin & Tahlil Softcover"
    description={[
      "Sangat cocok untuk pemesanan dalam jumlah besar dengan anggaran yang terbatas tanpa mengurangi kekhidmatan isi buku.",
    ]}
    classes={{ container: "pb-0 md:pb-0" }}
  />
  <Content2
    items={[
      {
        title: "Bahan Cover Tebal & Glossy",
        description:
          "Menggunakan kertas Art Carton 260gr yang tebal, dicetak full color, dan dilapisi laminating glossy/doff agar tahan air.",
      },
      {
        title: "Pilihan Isi Halaman Lengkap",
        description:
          "Tersedia pilihan isi mulai dari 128, 144, hingga 160 halaman dengan kertas HVS berkualitas tinggi.",
      },
    ]}
    image={webDevImg}
    imageAlt="Contoh Cetak Buku Yasin Softcover"
    classes={{ container: "pt-0 md:pt-0" }}
  >
    <Fragment>
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
        Spesifikasi Model Softcover
      </h3>
      Walaupun harganya sangat bersahabat, kami tetap memastikan hasil potongan rapi,
      jilid kuat, serta kualitas cetakan tulisan Arab yang tajam dan nyaman dibaca
      oleh jamaah.
    </Fragment>
  </Content2>

  {/* Detail Spesifikasi 2: Model Hardcover Premium */}
  <Content2
    isReversed={true}
    items={[
      {
        title: "Cover Board Tebal & Poly Emas",
        description:
          "Lapisan cover menggunakan board tebal yang tidak mudah melengkung, ditambah finishing hot print emas/perak pada nama almarhum.",
      },
      {
        title: "Sudut Siku Logam (Variasi)",
        description:
          "Bisa ditambahkan siku pembatas logam di setiap sudut buku untuk memberikan kesan yang jauh lebih mewah dan aman dari benturan.",
      },
    ]}
    image={seoImg}
    imageAlt="Contoh Cetak Buku Yasin Hardcover"
  >
    <Fragment>
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
        Spesifikasi Model Hardcover Premium
      </h3>
      Pilihan terbaik untuk memberikan cinderamata mengenang 40 hari atau 100 hari
      wafatnya keluarga dengan tampilan yang elegan, kokoh, dan tahan disimpan hingga
      bertahun-tahun.
    </Fragment>
  </Content2>

  {/* Bagian Fitur Tambahan: Redaksi Lembar Sisipan */}
  <Content2
    items={[
      {
        title: "Halaman Foto Almarhum Full Color",
        description:
          "Dicetak menggunakan kertas foto semi-glos (Art Paper) sehingga wajah almarhum/almarhumah terlihat jelas dan bersih.",
      },
      {
        title: "Susunan Nama Keluarga Tercinta",
        description:
          "Memuat daftar lengkap nama keluarga yang ditinggalkan, mulai dari pasangan, anak, menantu, hingga cucu.",
      },
    ]}
    image={webDevImg}
    imageAlt="Fitur Bonus dan Lembar Sisipan Redaksi"
  >
    <Fragment>
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
        Gratis Desain Lembar Sisipan Redaksi
      </h3>
      Setiap paket pemesanan di ABA Print sudah termasuk gratis pemasangan lembar
      sisipan redaksi di bagian depan buku. Tim desainer kami akan membantu menyusun
      tata letaknya sampai Anda setuju (ACC) sebelum naik cetak.
    </Fragment>
  </Content2>

  {/* CTA Section Kecil di Bawah */}
  <section
    class="section-brown py-12 border-t border-border text-center"
  >
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl">
        Ingin Tanya Model Lain atau Nego Harga?
      </h2>
      <p
        class="text-base text-gray-600 dark:text-neutral-400 mt-2 max-w-2xl mx-auto"
      >
        Hubungi tim customer service kami untuk mendapatkan penawaran harga
        terbaik khusus pemesanan dalam jumlah banyak beserta bonus
        tasbih/sajadah.
      </p>
      <div class="mt-6">
        <a
          href="https://wa.me/62895401308267"
          class="inline-flex items-center gap-2 justify-center px-6 py-3 bg-[#25D366] hover:bg-[#20BA5A] text-white rounded-xl font-bold text-base hover:shadow-lg hover:shadow-green-500/20 hover:scale-105 transform transition duration-300 shadow-md shadow-green-500/10"
        >
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Konsultasi via WhatsApp Gratis
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

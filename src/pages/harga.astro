---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Card from "@/components/ui/Card.astro";
import { Icon } from "astro-icon/components";

const metadata = {
  title: "Daftar Paket Harga Cetak Yasin — ABA Print",
  description:
    "Pilihan paket cetak buku Yasin mulai dari 18 Ribu hingga 42 Ribu dengan kualitas premium.",
};

const pricingPlans = [
  {
    title: "Paket Hemat",
    price: "Rp 18.000",
    features: ["Kertas HVS", "Softcover", "Gratis Desain", "Proses Cepat"],
  },
  {
    title: "Paket Standar",
    price: "Rp 22.000",
    features: [
      "Kertas Art Paper",
      "Softcover",
      "Foto Almarhum",
      "Finishing Rapi",
    ],
  },
  {
    title: "Paket Populer",
    price: "Rp 28.000",
    features: [
      "Hardcover Kokoh",
      "Laminasi Doff",
      "Pita Pembatas",
      "Foto & Data Keluarga",
    ],
    isPopular: true,
  },
  {
    title: "Paket Eksklusif",
    price: "Rp 33.000",
    features: [
      "Hardcover Linen",
      "Emboss Emas",
      "Kertas Premium",
      "Box Eksklusif",
    ],
  },
  {
    title: "Paket Luxury",
    price: "Rp 42.000",
    features: [
      "Cover Bludru",
      "Gold Foil Timbul",
      "Kertas Spesial",
      "Pita Premium",
    ],
  },
];

const cardVariants = ["sage", "blue", "amber", "clay", "blue"] as const;
---

<BaseLayout {metadata}>
  <section class="section-yellow py-20 dark:bg-slate-950">
    <div class="container mx-auto px-6 text-center">
      <span
        class="text-primary font-bold tracking-widest uppercase text-xs block mb-2"
      >
        Daftar Harga
      </span>
      <h1
        class="text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white mb-4"
      >
        Paket Harga Cetak Buku Yasin
      </h1>
      <p
        class="text-lg text-gray-600 dark:text-slate-400 mb-16 max-w-2xl mx-auto"
      >
        Pilih paket yang sesuai dengan kebutuhan kenangan terbaik Anda.
        Pengerjaan cepat & profesional.
      </p>

      {/* Grid fleksibel untuk 5 item */}
      <div
        class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6 items-stretch"
      >
        {
          pricingPlans.map((plan, index) => (
            <Card
              variant={
                plan.isPopular
                  ? "amber"
                  : cardVariants[index % cardVariants.length]
              }
              class={`p-6 flex flex-col justify-between ${plan.isPopular ? "border-secondary/60 shadow-xl scale-105 z-10" : ""}`}
            >
              <div>
                {plan.isPopular && (
                  <span class="bg-secondary text-white text-[10px] font-bold px-2 py-1 rounded-full uppercase mb-3 inline-block">
                    Paling Diminati
                  </span>
                )}
                <h2 class="text-lg font-bold text-gray-950 dark:text-white">
                  {plan.title}
                </h2>
                <p class="text-3xl font-extrabold my-4 text-primary dark:text-blue-400">
                  {plan.price}
                </p>
                <ul class="text-left space-y-2 mb-6">
                  {plan.features.map((feature) => (
                    <li class="flex items-center text-xs text-gray-700 dark:text-slate-300">
                      <Icon
                        name="lucide:check"
                        class="w-3.5 h-3.5 text-primary dark:text-blue-400 mr-2 flex-shrink-0"
                      />
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>
              <a
                href="https://wa.me/62895401308267"
                class="flex items-center justify-center gap-1.5 w-full py-2.5 text-center bg-[#25D366] hover:bg-[#20BA5A] text-white rounded-xl font-bold text-sm shadow-md shadow-green-500/10 hover:shadow-lg hover:shadow-green-500/20 hover:scale-[1.02] transform transition-all duration-200"
              >
                <Icon name="tabler:brand-whatsapp" class="w-4 h-4" />
                Pilih via WA
              </a>
            </Card>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
